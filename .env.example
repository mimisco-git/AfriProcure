# Cloud workspace (optional). Leave both unset to run AfriProcure as a single-user
# app that stores data in the browser. Find these in Supabase: Project Settings → API.
# The anon key is safe to expose; access is enforced by row-level security.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# GEMINI_API_KEY: reserved for AI features (AI Studio injects it at runtime).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
